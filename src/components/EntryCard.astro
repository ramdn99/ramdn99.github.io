---
interface Props {
  title: string;
  date: string;
  tags: string[];
  summary: string;
  excerpt: string;
  href: string;
  image?: string;
  difficulty?: string;
  readTime?: string;
}
const { title, date, tags, summary, href, image, difficulty, readTime } = Astro.props;

const isProject = href.includes('/projects/');

const formattedDate = date.includes('-') 
  ? date.split('-').join(' / ') 
  : date;

const diffTag = difficulty || tags.find(t => ['easy', 'medium', 'hard', 'insane'].includes(t.toLowerCase())) || (tags.find(t => t !== 'writeup' && t !== 'ctf') || tags[0]);
const cleanSummary = (summary && summary.toLowerCase().startsWith('category:'))
  ? (Astro.props.excerpt || summary.replace(/^category:\s*/i, ''))
  : (summary || Astro.props.excerpt);
---
<a href={href} class="card" data-tags={JSON.stringify(tags)}>
  {image && (
    <div class="card-banner">
      <img src={image} alt={title} loading="lazy" />
    </div>
  )}

  <div class="card-content">
    <div class="card-meta">
      <span class="card-date">{formattedDate}{readTime ? ` · ${readTime}` : ''}</span>
      {diffTag && <span class="card-badge">{diffTag}</span>}
    </div>

    <h3 class="card-title">{title}</h3>

    <p class="card-summary">{cleanSummary}</p>

    <div class="card-footer">
      <div class="tag-row">
        {tags.filter(t => t !== 'writeup').map((t) => <span class="mx-tag">{t}</span>)}
      </div>
      <span class="card-link-btn">
        {isProject ? 'view project →' : 'view writeup →'}
      </span>
    </div>
  </div>
</a>

<style>
  .card {
    background: var(--bg-panel-2);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    border-color: var(--border-bright);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }
  .card-banner {
    width: 100%;
    height: 190px;
    background: var(--bg-panel);
    overflow: hidden;
    position: relative;
    border-bottom: 1px solid var(--border);
  }
  .card-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.3s ease;
  }
  .card:hover .card-banner img {
    transform: scale(1.04);
  }
  .card-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 12px;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .card-date {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--blue-bright);
    letter-spacing: 0.05em;
  }
  .card-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #ff6b6b;
    border: 1px solid rgba(255, 107, 107, 0.4);
    background: rgba(255, 107, 107, 0.08);
    padding: 2px 8px;
    border-radius: 6px;
    letter-spacing: 0.04em;
  }
  .card-title {
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0;
    color: var(--text);
    transition: color 0.15s ease;
  }
  .card:hover .card-title {
    color: var(--blue-bright);
  }
  .card-summary {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    margin-top: auto;
    padding-top: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .tag-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .mx-tag {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-dim);
    background: var(--bg-panel);
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: 6px;
  }
  .card-link-btn {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--blue-bright);
    margin-left: auto;
    transition: color 0.15s ease;
  }
  .card:hover .card-link-btn {
    color: #8ccbff;
    text-decoration: underline;
  }
</style>
