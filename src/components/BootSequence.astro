---
---
<div id="boot-overlay">
  <div class="boot-term-container">
    <div class="boot-term term-card">
      <div class="term-header">
        <div class="term-controls">
          <span class="term-dot term-dot-red"></span>
          <span class="term-dot term-dot-yellow"></span>
          <span class="term-dot term-dot-green"></span>
        </div>
        <span class="term-title">boot_sequence.sh — ramdn SOC v2.4</span>
      </div>
      <div class="boot-inner">
        <div class="boot-header-badge">
          <span class="badge-tag">SOC//SYSTEM_BOOT</span>
          <span id="boot-status-badge" class="badge-status">INITIALIZING</span>
        </div>
        <div id="boot-lines" class="boot-lines"></div>
        <div class="boot-progress-wrap">
          <div class="boot-progress-bar">
            <div id="boot-progress-fill" class="boot-progress-fill"></div>
          </div>
          <div class="boot-progress-text">
            <span id="boot-progress-pct">0%</span>
            <span class="boot-cursor">_</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #boot-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #04060a;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), transform 0.7s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.7s ease;
    backdrop-filter: blur(20px);
  }
  #boot-overlay.hidden {
    opacity: 0;
    transform: scale(1.02);
    visibility: hidden;
    pointer-events: none;
  }
  :global(html.is-booted) #boot-overlay:not(.is-fading) {
    display: none !important;
  }
  .boot-term-container {
    width: 100%;
    max-width: 650px;
  }
  .boot-term {
    width: 100%;
    background: #080d16;
    border: 1px solid rgba(47, 129, 247, 0.35);
    border-radius: 14px;
    box-shadow: 0 0 50px rgba(47, 129, 247, 0.2), inset 0 0 15px rgba(47, 129, 247, 0.05);
    overflow: hidden;
  }
  .term-header {
    background: #0c1320;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(47, 129, 247, 0.2);
    position: relative;
  }
  .term-controls {
    display: flex;
    gap: 8px;
  }
  .term-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .term-dot-red { background: #ff5f56; box-shadow: 0 0 6px rgba(255, 95, 86, 0.6); }
  .term-dot-yellow { background: #ffbd2e; box-shadow: 0 0 6px rgba(255, 189, 46, 0.6); }
  .term-dot-green { background: #27c93f; box-shadow: 0 0 6px rgba(39, 201, 63, 0.6); }
  .term-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    color: var(--text-dim, #8b949e);
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .boot-inner {
    padding: 24px;
    height: 360px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.84rem;
  }
  .boot-header-badge {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed rgba(47, 129, 247, 0.25);
    padding-bottom: 12px;
    margin-bottom: 12px;
    font-size: 0.75rem;
    flex-shrink: 0;
  }
  .badge-tag {
    color: #58a6ff;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .badge-status {
    background: rgba(47, 129, 247, 0.15);
    color: #388bfd;
    padding: 3px 10px;
    border-radius: 6px;
    border: 1px solid rgba(47, 129, 247, 0.3);
    font-weight: 700;
    transition: all 0.3s ease;
  }
  .badge-status.badge-online {
    background: rgba(46, 160, 67, 0.2);
    color: #3fb950;
    border-color: rgba(63, 185, 80, 0.4);
    box-shadow: 0 0 10px rgba(63, 185, 80, 0.3);
  }
  .boot-lines {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
    overflow-y: auto;
    margin-bottom: 14px;
    padding-right: 4px;
    scrollbar-width: thin;
    scrollbar-color: rgba(47, 129, 247, 0.3) transparent;
  }
  .boot-line {
    line-height: 1.5;
    animation: fadeInLine 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .boot-line :global(.time-stamp) { color: #8b949e; opacity: 0.7; margin-right: 8px; }
  .boot-line :global(.tag-ok) { color: #3fb950; font-weight: 700; }
  .boot-line :global(.tag-init) { color: #d29922; font-weight: 700; }
  .boot-line :global(.tag-cmd) { color: #58a6ff; font-weight: 700; }
  .boot-line :global(.tag-ready) { color: #388bfd; font-weight: 700; text-shadow: 0 0 10px rgba(56, 139, 253, 0.7); }
  .boot-line :global(.text-msg) { color: #c9d1d9; }

  .boot-progress-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
    border-top: 1px solid rgba(47, 129, 247, 0.2);
    padding-top: 14px;
    flex-shrink: 0;
  }
  .boot-progress-bar {
    flex-grow: 1;
    height: 8px;
    background: #161b22;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid rgba(47, 129, 247, 0.25);
  }
  .boot-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #1f6beb, #58a6ff);
    box-shadow: 0 0 14px rgba(88, 166, 255, 0.8);
    transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .boot-progress-text {
    font-size: 0.82rem;
    color: #58a6ff;
    font-weight: 700;
    min-width: 52px;
    text-align: right;
  }
  .boot-cursor {
    animation: blink 0.8s step-end infinite;
    color: #58a6ff;
    font-weight: 700;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes fadeInLine { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

  @media (prefers-reduced-motion: reduce) {
    #boot-overlay { display: none; }
  }
</style>

<script>
  const overlay = document.getElementById('boot-overlay');
  const linesEl = document.getElementById('boot-lines');
  const progressFill = document.getElementById('boot-progress-fill');
  const progressPct = document.getElementById('boot-progress-pct');
  const statusBadge = document.getElementById('boot-status-badge');

  const script = [
    { time: '0.002814', html: '<span class="tag-cmd">guest@ramdn:~$</span> <span class="text-msg">./boot_sequence.sh --verbose</span>', pct: 10, delay: 280 },
    { time: '0.041290', html: '<span class="tag-init">[ INIT ]</span> <span class="text-msg">Initializing kernel architecture v4.19-sec...</span>', pct: 25, delay: 320 },
    { time: '0.108420', html: '<span class="tag-ok">[ OK ]</span> <span class="text-msg">Mounting /dev/skills & /dev/logs</span>', pct: 40, delay: 320 },
    { time: '0.245012', html: '<span class="tag-ok">[ OK ]</span> <span class="text-msg">Loading SOC & Blue Team Operations framework</span>', pct: 55, delay: 350 },
    { time: '0.419080', html: '<span class="tag-ok">[ OK ]</span> <span class="text-msg">Decrypting CTF writeups & digital forensics database</span>', pct: 70, delay: 350 },
    { time: '0.621004', html: '<span class="tag-ok">[ OK ]</span> <span class="text-msg">Synchronizing projects & security research labs</span>', pct: 85, delay: 320 },
    { time: '0.810520', html: '<span class="tag-ok">[ OK ]</span> <span class="text-msg">Verifying Education credentials (Luxor University FCI)</span>', pct: 95, delay: 280 },
    { time: '1.000000', html: '<span class="tag-ready">[ READY ]</span> <span class="text-msg">System online. Launching interface...</span>', pct: 100, delay: 400 },
  ];

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function finish() {
    overlay?.classList.add('is-fading');
    overlay?.classList.add('hidden');
    sessionStorage.setItem('booted', '1');
    setTimeout(() => {
      document.documentElement.classList.add('is-booted');
      overlay?.remove();
    }, 750);
  }

  let currentDisplayedPct = 0;
  function animatePct(targetPct: number) {
    if (!progressPct) return;
    const startPct = currentDisplayedPct;
    const duration = 250;
    const startTime = performance.now();

    function step(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(1, elapsed / duration);
      const val = Math.floor(startPct + (targetPct - startPct) * progress);
      currentDisplayedPct = val;
      if (progressPct) progressPct.textContent = val + '%';

      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        currentDisplayedPct = targetPct;
        if (progressPct) progressPct.textContent = targetPct + '%';
      }
    }
    requestAnimationFrame(step);
  }

  if (reduceMotion || sessionStorage.getItem('booted')) {
    sessionStorage.setItem('booted', '1');
    document.documentElement.classList.add('is-booted');
    overlay?.remove();
  } else {
    let stepIndex = 0;

    function runNextStep() {
      if (stepIndex >= script.length) {
        if (statusBadge) {
          statusBadge.textContent = 'ONLINE';
          statusBadge.classList.add('badge-online');
        }
        sessionStorage.setItem('booted', '1');
        setTimeout(finish, 350);
        return;
      }

      const current = script[stepIndex];
      const div = document.createElement('div');
      div.className = 'boot-line';
      div.innerHTML = `<span class="time-stamp">[ ${current.time} ]</span>` + current.html;
      
      if (linesEl) {
        linesEl.appendChild(div);
        linesEl.scrollTop = linesEl.scrollHeight;
      }

      if (progressFill) progressFill.style.width = current.pct + '%';
      animatePct(current.pct);

      stepIndex++;
      setTimeout(runNextStep, current.delay);
    }

    setTimeout(runNextStep, 150);
  }
</script>
