---
---
<div id="boot-overlay">
  <div class="boot-term-container">
    <div class="boot-term term-card">
      <div class="term-header">
        <div class="term-controls">
          <span class="term-dot term-dot-red"></span>
          <span class="term-dot term-dot-yellow"></span>
          <span class="term-dot term-dot-green"></span>
        </div>
        <span class="term-title">boot_sequence.sh — zeroXmoRamadan SOC v2.4</span>
      </div>
      <div class="boot-inner">
        <div class="boot-header-badge">
          <span class="badge-tag">SOC//SYSTEM_BOOT</span>
          <span class="badge-status">INITIALIZING</span>
        </div>
        <div id="boot-lines" class="boot-lines"></div>
        <div class="boot-progress-wrap">
          <div class="boot-progress-bar">
            <div id="boot-progress-fill" class="boot-progress-fill"></div>
          </div>
          <div class="boot-progress-text">
            <span id="boot-progress-pct">0%</span>
            <span class="boot-cursor">_</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #boot-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #04060a;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1), transform 1.2s cubic-bezier(0.4, 0, 0.2, 1), visibility 1.2s ease;
    backdrop-filter: blur(20px);
  }
  #boot-overlay.hidden {
    opacity: 0;
    transform: scale(1.03);
    visibility: hidden;
    pointer-events: none;
  }
  :global(html.is-booted) #boot-overlay:not(.is-fading) {
    display: none !important;
  }
  .boot-term-container {
    width: 100%;
    max-width: 640px;
  }
  .boot-term {
    width: 100%;
    background: #080d16;
    border: 1px solid rgba(47, 129, 247, 0.35);
    border-radius: 12px;
    box-shadow: 0 0 50px rgba(47, 129, 247, 0.2), inset 0 0 15px rgba(47, 129, 247, 0.05);
    overflow: hidden;
  }
  .term-header {
    background: #0c1320;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(47, 129, 247, 0.2);
    position: relative;
  }
  .term-controls {
    display: flex;
    gap: 8px;
  }
  .term-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .term-dot-red { background: #ff5f56; }
  .term-dot-yellow { background: #ffbd2e; }
  .term-dot-green { background: #27c93f; }
  .term-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    color: var(--text-dim, #8b949e);
    letter-spacing: 0.05em;
  }
  .boot-inner {
    padding: 24px;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.84rem;
  }
  .boot-header-badge {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed rgba(47, 129, 247, 0.25);
    padding-bottom: 12px;
    margin-bottom: 16px;
    font-size: 0.75rem;
  }
  .badge-tag {
    color: #58a6ff;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .badge-status {
    background: rgba(47, 129, 247, 0.15);
    color: #388bfd;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(47, 129, 247, 0.3);
  }
  .boot-lines {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
    margin-bottom: 20px;
  }
  .boot-line {
    line-height: 1.5;
    animation: fadeInLine 0.2s ease;
  }
  .boot-line :global(.tag-ok) { color: #3fb950; font-weight: 700; }
  .boot-line :global(.tag-init) { color: #d29922; font-weight: 700; }
  .boot-line :global(.tag-cmd) { color: #58a6ff; font-weight: 700; }
  .boot-line :global(.tag-ready) { color: #388bfd; font-weight: 700; text-shadow: 0 0 8px rgba(56, 139, 253, 0.6); }
  .boot-line :global(.text-msg) { color: #c9d1d9; }

  .boot-progress-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
    border-top: 1px solid rgba(47, 129, 247, 0.2);
    padding-top: 16px;
  }
  .boot-progress-bar {
    flex-grow: 1;
    height: 8px;
    background: #161b22;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid rgba(47, 129, 247, 0.2);
  }
  .boot-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #1f6beb, #58a6ff);
    box-shadow: 0 0 12px rgba(88, 166, 255, 0.8);
    transition: width 0.3s ease;
  }
  .boot-progress-text {
    font-size: 0.82rem;
    color: #58a6ff;
    font-weight: 700;
    min-width: 50px;
    text-align: right;
  }
  .boot-cursor {
    animation: blink 0.8s step-end infinite;
    color: #58a6ff;
    font-weight: 700;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes fadeInLine { from { opacity: 0; transform: translateY(2px); } to { opacity: 1; transform: translateY(0); } }

  @media (prefers-reduced-motion: reduce) {
    #boot-overlay { display: none; }
  }
</style>

<script>
  const overlay = document.getElementById('boot-overlay');
  const linesEl = document.getElementById('boot-lines');
  const progressFill = document.getElementById('boot-progress-fill');
  const progressPct = document.getElementById('boot-progress-pct');

  const script = [
    { html: '<span class="tag-cmd">guest@zeroXmoRamadan:~$</span> <span class="text-msg">./boot_sequence.sh --verbose</span>', pct: 10, delay: 350 },
    { html: '<span class="tag-init">[ INIT ]</span> <span class="text-msg">Initializing kernel architecture v4.19-sec...</span>', pct: 25, delay: 400 },
    { html: '<span class="tag-ok">[ OK ]</span> <span class="text-msg">Mounting /dev/skills & /dev/logs</span>', pct: 40, delay: 400 },
    { html: '<span class="tag-ok">[ OK ]</span> <span class="text-msg">Loading SOC & Blue Team Operations framework</span>', pct: 55, delay: 450 },
    { html: '<span class="tag-ok">[ OK ]</span> <span class="text-msg">Decrypting CTF writeups & digital forensics database</span>', pct: 70, delay: 450 },
    { html: '<span class="tag-ok">[ OK ]</span> <span class="text-msg">Synchronizing projects & security research labs</span>', pct: 85, delay: 400 },
    { html: '<span class="tag-ok">[ OK ]</span> <span class="text-msg">Verifying Education credentials (Luxor University FCI)</span>', pct: 95, delay: 350 },
    { html: '<span class="tag-ready">[ READY ]</span> <span class="text-msg">System online. Launching interface...</span>', pct: 100, delay: 500 },
  ];

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function finish() {
    overlay?.classList.add('is-fading');
    overlay?.classList.add('hidden');
    sessionStorage.setItem('booted', '1');
    setTimeout(() => {
      document.documentElement.classList.add('is-booted');
      overlay?.remove();
    }, 1250);
  }

  if (reduceMotion || sessionStorage.getItem('booted')) {
    sessionStorage.setItem('booted', '1');
    document.documentElement.classList.add('is-booted');
    overlay?.remove();
  } else {
    let step = 0;
    function runStep() {
      if (step >= script.length) {
        sessionStorage.setItem('booted', '1');
        setTimeout(finish, 400);
        return;
      }
      const current = script[step];
      const div = document.createElement('div');
      div.className = 'boot-line';
      div.innerHTML = current.html;
      linesEl?.appendChild(div);

      if (progressFill) progressFill.style.width = current.pct + '%';
      if (progressPct) progressPct.textContent = current.pct + '%';

      step++;
      setTimeout(runStep, current.delay);
    }
    setTimeout(runStep, 200);
  }
</script>
