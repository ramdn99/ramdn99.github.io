---
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---
<div class="tag-filter-bar is-collapsed" data-tag-filter-bar>
  <div class="tag-filter-header">
    <span class="tag-filter-label">
      <span class="dim">$</span> filter --tag
    </span>
    <button type="button" class="tag-filter-toggle" data-tag-filter-toggle aria-expanded="false" title="Toggle tag filters">
      <span class="tf-toggle-text">SHOW</span>
      <span class="tf-toggle-icon">▼</span>
    </button>
  </div>
  <div class="tag-filter-options" data-tag-filter-options>
    <button type="button" class="tag-btn tag-btn-active" data-tag="all">
      all
    </button>
    {tags.map((t) => (
      <button type="button" class="tag-btn" data-tag={t}>
        {t}
      </button>
    ))}
  </div>
</div>

<script>
  function setupTagFilter() {
    const filterBars = document.querySelectorAll('[data-tag-filter-bar]');
    
    filterBars.forEach((bar) => {
      const toggleBtn = bar.querySelector<HTMLButtonElement>('[data-tag-filter-toggle]');
      const toggleText = bar.querySelector<HTMLElement>('.tf-toggle-text');
      const toggleIcon = bar.querySelector<HTMLElement>('.tf-toggle-icon');

      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const isCollapsed = bar.classList.toggle('is-collapsed');
          toggleBtn.setAttribute('aria-expanded', String(!isCollapsed));
          if (toggleText) toggleText.textContent = isCollapsed ? 'SHOW' : 'HIDE';
          if (toggleIcon) toggleIcon.textContent = isCollapsed ? '▼' : '▲';
        });
      }

      const buttons = bar.querySelectorAll<HTMLButtonElement>('.tag-btn');
      const section = bar.closest('.dsec');
      if (!section) return;
      
      const cards = section.querySelectorAll<HTMLElement>('.card[data-tags]');
      const metaSpan = section.querySelector<HTMLElement>('.dsec-meta');
      const totalCount = cards.length;
      
      const activeTags = new Set<string>();

      function updateUIAndFilter() {
        const allBtn = bar.querySelector<HTMLButtonElement>('.tag-btn[data-tag="all"]');

        if (activeTags.size === 0) {
          buttons.forEach((b) => b.classList.remove('tag-btn-active'));
          if (allBtn) allBtn.classList.add('tag-btn-active');
        } else {
          if (allBtn) allBtn.classList.remove('tag-btn-active');
          buttons.forEach((b) => {
            const tag = b.getAttribute('data-tag');
            if (tag !== 'all') {
              if (activeTags.has(tag!)) {
                b.classList.add('tag-btn-active');
              } else {
                b.classList.remove('tag-btn-active');
              }
            }
          });
        }

        let visibleCount = 0;

        cards.forEach((card) => {
          const rawTags = card.getAttribute('data-tags');
          let cardTags: string[] = [];
          try {
            cardTags = rawTags ? JSON.parse(rawTags) : [];
          } catch {
            cardTags = [];
          }

          if (activeTags.size === 0) {
            card.style.display = '';
            visibleCount++;
          } else {
            // Card must match all selected active tags
            const matches = Array.from(activeTags).every((t) => cardTags.includes(t));
            if (matches) {
              card.style.display = '';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          }
        });

        if (metaSpan) {
          let suffix = 'entries';
          const originalText = metaSpan.getAttribute('data-original-meta') || metaSpan.textContent || '';
          if (!metaSpan.hasAttribute('data-original-meta')) {
            metaSpan.setAttribute('data-original-meta', originalText);
          }
          const match = originalText.trim().match(/^\d+\s+(.*)$/);
          if (match && match[1]) {
            suffix = match[1];
          }
          metaSpan.textContent = `${visibleCount} ${suffix}`;
        }
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const tag = btn.getAttribute('data-tag');
          if (!tag) return;

          if (tag === 'all') {
            activeTags.clear();
          } else {
            if (activeTags.has(tag)) {
              activeTags.delete(tag);
            } else {
              activeTags.add(tag);
            }
          }

          updateUIAndFilter();
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTagFilter);
  } else {
    setupTagFilter();
  }
</script>

<style>
  .tag-filter-bar {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
    padding: 10px 14px;
    background: var(--bg-panel-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
  }
  .tag-filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }
  .tag-filter-label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-dim);
    font-weight: 600;
    white-space: nowrap;
  }
  .tag-filter-toggle {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-dim);
    background: var(--bg-panel);
    border: 1px solid var(--border);
    padding: 3px 9px;
    border-radius: var(--radius-xs);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all 0.15s ease;
  }
  .tag-filter-toggle:hover {
    color: var(--blue-bright);
    border-color: var(--border-bright);
    background: rgba(47, 129, 247, 0.08);
  }
  .tag-filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    transition: all 0.2s ease;
  }
  .tag-filter-bar.is-collapsed .tag-filter-options {
    display: none;
  }
  .tag-btn {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-dim);
    background: var(--bg-panel);
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    text-transform: lowercase;
  }
  .tag-btn:hover {
    color: var(--blue-bright);
    border-color: var(--blue);
    background: rgba(47, 129, 247, 0.08);
  }
  .tag-btn.tag-btn-active {
    color: var(--blue-bright);
    background: rgba(47, 129, 247, 0.15);
    border-color: var(--blue-bright);
    box-shadow: 0 0 8px rgba(47, 129, 247, 0.25);
    font-weight: 700;
  }
</style>
