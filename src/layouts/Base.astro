---
import '../styles/global.css';
import BootSequence from '../components/BootSequence.astro';
import faviconImage from '../assets/favicon.png';

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const { title, description = 'Blue Team & Cybersecurity blog.', image } = Astro.props;
const siteTitle = title || './ramdn.sh';

const siteOrigin = Astro.site ? Astro.site.origin : 'https://ramdn.me';
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);

// Default to static lightweight og-image.png for social link previews (WhatsApp, Telegram, etc.)
const defaultOgImage = '/og-image.png';
const metaImage = image || defaultOgImage;
const socialImageURL = new URL(metaImage, siteOrigin);
const imageType = socialImageURL.pathname.endsWith('.jpg') || socialImageURL.pathname.endsWith('.jpeg') ? 'image/jpeg' : (socialImageURL.pathname.endsWith('.webp') ? 'image/webp' : 'image/png');
const twitterCardType = image ? 'summary_large_image' : 'summary';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={faviconImage.src} />
    <link rel="apple-touch-icon" href={faviconImage.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet" />
    <title>{siteTitle}</title>

    <!-- Canonical URL & Image Fallbacks -->
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="image_src" href={socialImageURL.href} />
    <meta itemprop="image" content={socialImageURL.href} />

    <!-- Open Graph / WhatsApp / Telegram / Facebook / LinkedIn / Discord -->
    <meta property="og:site_name" content="./ramdn.sh" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL.href} />
    <meta property="og:image:secure_url" content={socialImageURL.href} />
    <meta property="og:image:type" content={imageType} />

    <!-- Twitter -->
    <meta name="twitter:card" content={twitterCardType} />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL.href} />
    <script is:inline>
      if (sessionStorage.getItem('booted') || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('is-booted');
      }
    </script>
  </head>
  <body>
    <BootSequence />
    
    <!-- BACKGROUND FX LAYERS (ibraradi style) -->
    <div class="fx fx-grid" aria-hidden="true"></div>
    <div class="fx fx-scan" aria-hidden="true"></div>
    <div class="fx fx-spot" aria-hidden="true"></div>

    <header class="classbar">
      <div class="classbar-inner">
        <a class="cb-left" href="/" title="Home">
          ./ramdn.sh
        </a>
        <span class="cb-right">
          <i class="led-dot"></i>
          <span data-clock>00:00:00</span> EGY
        </span>
      </div>
    </header>

    <main id="main">
      <div class="doc">
        <slot />
      </div>
    </main>

    <footer class="docfoot">
      <div class="docfoot-inner">
        <span class="eof-tag">-- EOF --</span>
        <span class="dim footer-cmd">guest@portfolio:~$ <span class="cmd-echo">exit</span></span>
      </div>
    </footer>

    <!-- FLYOUT BACK TO TOP BUTTON -->
    <button type="button" id="back-to-top" class="back-to-top-btn" aria-label="Back to top" title="Back to top">
      <span class="btt-icon">↑</span>
      <span class="btt-text">TOP</span>
    </button>

    <script src="../scripts/scramble.ts"></script>
    <script>
      function updateClock() {
        const clockEls = document.querySelectorAll<HTMLElement>('[data-clock]');
        if (!clockEls.length) return;
        const now = new Date();
        const str = now.toLocaleTimeString('en-US', {
          timeZone: 'Africa/Cairo',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
        });
        clockEls.forEach((el) => (el.textContent = str));
      }
      updateClock();
      setInterval(updateClock, 1000);

      function setupBackToTop() {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;

        const toggleVisible = () => {
          if (window.scrollY > 250) {
            btn.classList.add('is-visible');
          } else {
            btn.classList.remove('is-visible');
          }
        };

        window.addEventListener('scroll', toggleVisible, { passive: true });
        toggleVisible();

        btn.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth',
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupBackToTop);
      } else {
        setupBackToTop();
      }
    </script>
  </body>
</html>
