---
import Base from '../layouts/Base.astro';
import EntryCard from '../components/EntryCard.astro';
import { getCollection } from 'astro:content';
import { plainExcerpt, extractFirstImage } from '../lib/excerpt';

function parseDate(d: string): number {
  if (d.includes('-') && d.split('-')[0].length === 2) {
    const [dd, mm, yyyy] = d.split('-');
    return new Date(parseInt(yyyy, 10), parseInt(mm, 10) - 1, parseInt(dd, 10)).getTime();
  }
  return new Date(d).getTime();
}

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => parseDate(b.data.date) - parseDate(a.data.date));

const writeups = (await getCollection('writeups', ({ data }) => !data.draft))
  .sort((a, b) => parseDate(b.data.date) - parseDate(a.data.date));

const gsocWriteups = (await getCollection('gsoc', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, undefined, { numeric: true, sensitivity: 'base' }));

const cheatSheets = (await getCollection('cheatSheets', ({ data }) => !data.draft))
  .sort((a, b) => parseDate(b.data.date) - parseDate(a.data.date));

const achievements = (await getCollection('achievements'))
  .sort((a, b) => a.data.order - b.data.order || parseDate(b.data.date) - parseDate(a.data.date));

const skills = {
  'SOC & Blue Team Operations': ['Security monitoring', 'Alert triage', 'Log investigation', 'Incident detection', 'SOC workflows'],
  'Network Analysis': ['Wireshark', 'tcpdump', 'Tshark', 'NetworkMiner', 'Traffic analysis'],
  'DFIR & Forensics': ['Autopsy', 'FTK', 'Volatility', 'Eric Zimmerman tools', 'Memory and disk analysis'],
  'Threat Intelligence & OSINT': ['IOC identification', 'Threat analysis', 'OSINT methodologies'],
};
---
<Base title="./ramdn.sh" image="/images/website-cover.jpg">
  <!-- TITLE BLOCK HERO (ibraradi style) -->
  <section class="doc-hero">
    <div>
      <p class="dh-kicker">
        guest@portfolio:~$ ./ramdn.sh --render
      </p>
      <h1 class="dh-name">
        <span class="grad" data-scramble>Mohamed Ramadan</span>
      </h1>
      <p class="dh-alias">AKA <span class="font-tajawal" data-scramble>رمضن</span> · SOC Analyst L1</p>
    </div>
    <div class="photo" aria-label="Profile Photo">
      <span class="xhair tl"></span>
      <span class="xhair tr"></span>
      <span class="xhair bl"></span>
      <span class="xhair br"></span>
      <img src="/images/pfp.png" alt="Subject Profile" />
    </div>
  </section>

  <!-- $ whoami -->
  <section class="dsec" id="whoami">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">whoami</span>
      <span class="dsec-meta">verified</span>
    </div>
    <div class="whoami-bio">
      <p>
        Fresh graduate from the Faculty of Computers and Information, Luxor University, with a focus on cybersecurity. Background in Blue Team operations, including monitoring, alert handling, and basic incident analysis. Familiar with log analysis, threat detection, and DFIR fundamentals through practical labs. Knowledge of OSINT techniques and threat intelligence concepts for identifying indicators of compromise.
      </p>
    </div>
  </section>

  <!-- $ getcap -->
  <section class="dsec" id="getcap">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">getcap</span>
      <span class="dsec-meta">4 domains</span>
    </div>
    <div class="matrix">
      {Object.entries(skills).map(([domain, items]) => (
        <div class="mx-cell">
          <div class="mx-cat">{domain}</div>
          <div class="mx-tags">
            {items.map((item) => (
              <span class="mx-tag">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- $ cat history.log -->
  <section class="dsec" id="history">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">cat history.log</span>
      <span class="dsec-meta">{achievements.length} logged</span>
    </div>
    <div class="creds">
      {achievements.map((a, idx) => {
        const findingId = `LOG-00${idx + 1}`;
        return (
          <div class="cred">
            <div class="cred-k">{findingId}</div>
            <div class="cred-main">{a.data.title}</div>
            {a.data.images.length > 0 && (
              <div class="finding-images">
                {a.data.images.slice(0, 4).map((img) => (
                  <img src={img} alt={a.data.title} loading="lazy" />
                ))}
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <!-- $ ls ./projects -->
  <section class="dsec" id="projects">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">ls ./projects</span>
      <span class="dsec-meta">{projects.length} indexed</span>
    </div>
    <div class="card-grid">
      {projects.slice(0, 4).map((p) => (
        <EntryCard
          title={p.data.title}
          date={p.data.date}
          tags={p.data.tags}
          summary={p.data.summary}
          excerpt={plainExcerpt(p)}
          image={extractFirstImage(p)}
          href={`/projects/${p.id}/`}
        />
      ))}
    </div>
    <div class="see-more-wrap">
      <a class="btn see-all-btn" href="/projects/">
        see all projects ({projects.length}) →
      </a>
    </div>
  </section>

  <!-- $ ls ./write_ups -->
  <section class="dsec" id="writeups">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">ls ./write_ups</span>
      <span class="dsec-meta">{writeups.length} entries</span>
    </div>
    <div class="card-grid">
      {writeups.slice(0, 4).map((w) => (
        <EntryCard
          title={w.data.title}
          date={w.data.date}
          tags={w.data.tags}
          summary={w.data.summary}
          excerpt={plainExcerpt(w)}
          image={extractFirstImage(w)}
          readTime={w.data.readTime}
          href={`/write_ups/${w.id}/`}
        />
      ))}
    </div>
    <div class="see-more-wrap">
      <a class="btn see-all-btn" href="/write_ups/">
        see all writeups ({writeups.length}) →
      </a>
    </div>
  </section>

  <!-- $ ls ./GSOC -->
  <section class="dsec" id="gsoc">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">ls ./GSOC</span>
      <span class="dsec-meta">{gsocWriteups.length} entries</span>
    </div>
    <div class="card-grid">
      {gsocWriteups.slice(0, 4).map((g) => (
        <EntryCard
          title={g.data.title}
          date={g.data.date}
          tags={g.data.tags}
          summary={g.data.summary}
          excerpt={plainExcerpt(g)}
          image={extractFirstImage(g)}
          readTime={g.data.readTime}
          href={`/gsoc/${g.id}/`}
        />
      ))}
    </div>
    <div class="see-more-wrap">
      <a class="btn see-all-btn" href="/gsoc/">
        see all GSOC material ({gsocWriteups.length}) →
      </a>
    </div>
  </section>

  <!-- $ ls ./cheatSheets -->
  <section class="dsec" id="cheatSheets">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">ls ./cheatSheets</span>
      <span class="dsec-meta">{cheatSheets.length} indexed</span>
    </div>
    <div class="card-grid">
      {cheatSheets.slice(0, 4).map((c) => (
        <EntryCard
          title={c.data.title}
          date={c.data.date}
          tags={c.data.tags}
          summary={c.data.summary}
          excerpt={plainExcerpt(c)}
          image={extractFirstImage(c)}
          readTime={c.data.readTime}
          href={`/cheatSheets/${c.id}/`}
        />
      ))}
    </div>
    <div class="see-more-wrap">
      <a class="btn see-all-btn" href="/cheatSheets/">
        see all cheatSheets ({cheatSheets.length}) →
      </a>
    </div>
  </section>

  <!-- $ cat edu.log -->
  <section class="dsec" id="edu">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">cat edu.log</span>
      <span class="dsec-meta">EDUCATION</span>
    </div>
    <div class="creds">
      <div class="cred">
        <div class="cred-k">EDUCATION</div>
        <div class="cred-main">Faculty of Computers &amp; Information</div>
        <div class="cred-sub">Luxor University · 2022 — 2026</div>
        <div class="cred-sub dim">Grade: Very Good</div>
      </div>
    </div>
  </section>

  <!-- $ nc ramdn.me -->
  <section class="dsec" id="comms">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">nc ramdn.me</span>
      <span class="dsec-meta">open channels</span>
    </div>
    <div class="dcomms">
      <a href="mailto:m.ramadan.tech@gmail.com" title="Send Email">
        <svg class="dc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        <span class="dc-name">Email</span>
      </a>
      <a href="https://github.com/ramdn99" target="_blank" rel="noopener noreferrer" title="GitHub Profile">
        <svg class="dc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
          <path d="M9 18c-4.51 2-5-2-7-2"/>
        </svg>
        <span class="dc-name">GitHub</span>
      </a>
      <a href="https://www.linkedin.com/in/ramdn99/" target="_blank" rel="noopener noreferrer" title="LinkedIn Profile">
        <svg class="dc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect width="4" height="12" x="2" y="9"/>
          <circle cx="4" cy="4" r="2"/>
        </svg>
        <span class="dc-name">LinkedIn</span>
      </a>
      <a href="https://medium.com/@ramdn99" target="_blank" rel="noopener noreferrer" title="Medium Profile">
        <svg class="dc-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42c1.87 0 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
        </svg>
        <span class="dc-name">Medium</span>
      </a>
      <a href="https://pieceof.link/ramdn99" target="_blank" rel="noopener noreferrer" title="All my links" class="dc-full">
        <svg class="dc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </svg>
        <span class="dc-name">All my links</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 24px;
  }
  .see-more-wrap {
    margin-top: 20px;
    display: flex;
    justify-content: flex-end;
  }
  .see-all-btn {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
</style>
