---
import Base from '../layouts/Base.astro';
import TreeSection from '../components/TreeSection.astro';
import { getCollection } from 'astro:content';

function parseDate(d: string): number {
  if (d.includes('-') && d.split('-')[0].length === 2) {
    const [dd, mm, yyyy] = d.split('-');
    return new Date(parseInt(yyyy, 10), parseInt(mm, 10) - 1, parseInt(dd, 10)).getTime();
  }
  return new Date(d).getTime();
}

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => parseDate(b.data.date) - parseDate(a.data.date))
  .map((p) => ({ slug: p.id, title: p.data.title, date: p.data.date, summary: p.data.summary, tags: p.data.tags }));

const writeups = (await getCollection('writeups', ({ data }) => !data.draft))
  .sort((a, b) => parseDate(b.data.date) - parseDate(a.data.date))
  .map((w) => ({ slug: w.id, title: w.data.title, date: w.data.date, summary: w.data.summary, tags: w.data.tags }));

const achievements = (await getCollection('achievements'))
  .sort((a, b) => a.data.order - b.data.order || parseDate(b.data.date) - parseDate(a.data.date));

const skills = {
  'SOC & Blue Team Operations': ['Security monitoring', 'Alert triage', 'Log investigation', 'Incident detection', 'SOC workflows'],
  'Network Analysis': ['Wireshark', 'tcpdump', 'Tshark', 'NetworkMiner', 'Traffic analysis'],
  'DFIR & Forensics': ['Autopsy', 'FTK', 'Volatility', 'Eric Zimmerman tools', 'Memory and disk analysis'],
  'Threat Intelligence & OSINT': ['IOC identification', 'Threat analysis', 'OSINT methodologies'],
};
---
<Base title="whoami — portfolio">
  <!-- TITLE BLOCK HERO (ibraradi style) -->
  <section class="doc-hero">
    <div>
      <p class="dh-kicker">
        guest@portfolio:~$ ./ramdn.sh --render
      </p>
      <h1 class="dh-name">
        <span class="grad" data-scramble>Mohamed Ramadan</span>
      </h1>
      <p class="dh-alias">aka @zeroXmoRamadan · SOC Analyst L1</p>
    </div>
    <div class="photo" aria-label="Profile Photo">
      <span class="xhair tl"></span>
      <span class="xhair tr"></span>
      <span class="xhair bl"></span>
      <span class="xhair br"></span>
      <img src="/images/pfp.png" alt="Subject Profile" />
    </div>
  </section>

  <!-- $ whoami -->
  <section class="dsec" id="whoami">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">whoami</span>
      <span class="dsec-meta">verified</span>
    </div>
    <div class="whoami-bio">
      <p>
        Fresh graduate from the Faculty of Computers and Information, Luxor University, with a focus on cybersecurity. Background in Blue Team operations, including monitoring, alert handling, and basic incident analysis. Familiar with log analysis, threat detection, and DFIR fundamentals through practical labs. Knowledge of OSINT techniques and threat intelligence concepts for identifying indicators of compromise.
      </p>
    </div>
  </section>

  <!-- $ getcap -->
  <section class="dsec" id="getcap">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">getcap</span>
      <span class="dsec-meta">4 domains</span>
    </div>
    <div class="matrix">
      {Object.entries(skills).map(([domain, items]) => (
        <div class="mx-cell">
          <div class="mx-cat">{domain}</div>
          <div class="mx-tags">
            {items.map((item) => (
              <span class="mx-tag">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- $ cat history.log -->
  <section class="dsec" id="history">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">cat history.log</span>
      <span class="dsec-meta">{achievements.length} logged</span>
    </div>
    <div class="findings">
      {achievements.map((a, idx) => {
        const findingId = `LOG-00${idx + 1}`;
        return (
          <article class="finding">
            <div class="finding-top">
              <span class="finding-id">{findingId}</span>
            </div>
            <h3 class="finding-title" data-scramble>{a.data.title}</h3>
            {a.data.images.length > 0 && (
              <div class="finding-images">
                {a.data.images.slice(0, 4).map((img) => (
                  <img src={img} alt={a.data.title} loading="lazy" />
                ))}
              </div>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <!-- $ tree ./projects -->
  <section class="dsec" id="projects">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">tree ./projects</span>
      <span class="dsec-meta">{projects.length} indexed</span>
    </div>
    <TreeSection cmd="tree ./projects" items={projects} basePath="/projects" moreHref="/projects/" maxShown={3} />
  </section>

  <!-- $ tree ./write_ups -->
  <section class="dsec" id="writeups">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">tree ./write_ups</span>
      <span class="dsec-meta">{writeups.length} entries</span>
    </div>
    <TreeSection cmd="tree ./write_ups" items={writeups} basePath="/write_ups" moreHref="/write_ups/" maxShown={3} />
  </section>

  <!-- $ cat edu.log -->
  <section class="dsec" id="edu">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">cat edu.log</span>
      <span class="dsec-meta">EDUCATION</span>
    </div>
    <div class="creds">
      <div class="cred">
        <div class="cred-k">EDUCATION</div>
        <div class="cred-main" data-scramble>Faculty of Computers &amp; Information</div>
        <div class="cred-sub">Luxor University · 2022 — 2026</div>
        <div class="cred-sub dim">Grade: Very Good</div>
      </div>
    </div>
  </section>

  <!-- $ comms -->
  <section class="dsec" id="comms">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">comms</span>
      <span class="dsec-meta">open channels</span>
    </div>
    <div class="dcomms">
      <a href="mailto:m.ramadan.tech@gmail.com">
        <span class="dc-k">→ email</span>
        <span class="dc-v">m.ramadan.tech@gmail.com</span>
      </a>
      <a href="https://github.com/zeroXmoRamadan" target="_blank" rel="noopener noreferrer">
        <span class="dc-k">→ github</span>
        <span class="dc-v">github.com/zeroXmoRamadan</span>
      </a>
      <a href="https://www.linkedin.com/in/mohamed-ramadan-me/" target="_blank" rel="noopener noreferrer">
        <span class="dc-k">→ linkedin</span>
        <span class="dc-v">linkedin.com/in/mohamed-ramadan-me</span>
      </a>
    </div>
  </section>
</Base>
