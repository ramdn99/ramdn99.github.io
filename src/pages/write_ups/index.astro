---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import TagFilterBar from '../../components/TagFilterBar.astro';
import { getCollection } from 'astro:content';
import { plainExcerpt } from '../../lib/excerpt';

function parseDate(d: string): number {
  if (d.includes('-') && d.split('-')[0].length === 2) {
    const [dd, mm, yyyy] = d.split('-');
    return new Date(parseInt(yyyy, 10), parseInt(mm, 10) - 1, parseInt(dd, 10)).getTime();
  }
  return new Date(d).getTime();
}

function extractFirstImage(markdown: string): string | undefined {
  const match = markdown.match(/!\[.*?\]\((.*?)\)/);
  return match ? match[1] : undefined;
}

const entries = (await getCollection('writeups', ({ data }) => !data.draft))
  .sort((a, b) => parseDate(b.data.date) - parseDate(a.data.date));

const allTags = Array.from(new Set(entries.flatMap((e) => e.data.tags || []))).sort();
---
<Base title="./write_ups — ./ramdn.sh">
  <section class="dsec">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">tree ./write_ups --all</span>
      <span class="dsec-meta">{entries.length} entries</span>
    </div>

    <TagFilterBar tags={allTags} />

    <div class="card-grid">
      {entries.map((e) => (
        <EntryCard
          title={e.data.title}
          date={e.data.date}
          tags={e.data.tags}
          summary={e.data.summary}
          excerpt={plainExcerpt(e.body)}
          image={extractFirstImage(e.body)}
          readTime={e.data.readTime}
          href={`/write_ups/${e.id}/`}
        />
      ))}
    </div>
  </section>
</Base>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 24px;
  }
</style>
