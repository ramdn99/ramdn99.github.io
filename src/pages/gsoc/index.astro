---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import TagFilterBar from '../../components/TagFilterBar.astro';
import { getCollection } from 'astro:content';
import { plainExcerpt, extractFirstImage } from '../../lib/excerpt';

const entries = (await getCollection('gsoc', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, undefined, { numeric: true, sensitivity: 'base' }));

const allTags = Array.from(new Set(entries.flatMap((e) => e.data.tags || []))).sort();
---
<Base title="./GSOC — ./ramdn.sh" image="/images/gsoc-cover.jpg">
  <section class="dsec">
    <div class="dsec-head">
      <span class="dsec-prompt">$</span>
      <span class="dsec-title">tree ./GSOC --all</span>
      <span class="dsec-meta">{entries.length} modules</span>
    </div>

    <!-- GSOC Course Index Panel -->
    <div class="gsoc-index-panel is-collapsed" data-gsoc-index-panel>
      <div class="gsoc-index-header">
        <span class="gsoc-index-title">
          <span class="gsoc-prompt">$</span> cat SEC450-Index.md
        </span>
        <div class="gsoc-header-actions">
          <button type="button" class="gsoc-index-toggle" id="gsoc-index-toggle" aria-expanded="false" title="Toggle module index">
            <span class="gi-toggle-text">SHOW</span>
            <span class="gi-toggle-icon">▼</span>
          </button>
        </div>
      </div>
      <div class="gsoc-index-content" id="gsoc-index-content">
        <div class="gsoc-module-title">SEC450.1 — Blue Team Tools and Operations (Book 1)</div>
        <div class="gsoc-index-grid">
          {entries.map((e) => (
            <a href={`/gsoc/${e.id}/`} class="gsoc-index-item">
              <span class="gsoc-item-name">{e.data.title}</span>
              <span class="gsoc-item-arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <TagFilterBar tags={allTags} />

    <div class="gsoc-section-label">SEC450.1 (Book 1)</div>
    <div class="card-grid">
      {entries.map((e) => (
        <EntryCard
          title={e.data.title}
          date={e.data.date}
          tags={e.data.tags}
          summary={e.data.summary}
          excerpt={plainExcerpt(e)}
          image={extractFirstImage(e)}
          readTime={e.data.readTime}
          href={`/gsoc/${e.id}/`}
        />
      ))}
    </div>
  </section>
</Base>

<script>
  function setupGsocIndexToggle() {
    const panel = document.querySelector('[data-gsoc-index-panel]');
    const toggleBtn = document.getElementById('gsoc-index-toggle');
    const toggleText = toggleBtn?.querySelector('.gi-toggle-text');
    const toggleIcon = toggleBtn?.querySelector('.gi-toggle-icon');

    if (panel && toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const isCollapsed = panel.classList.toggle('is-collapsed');
        toggleBtn.setAttribute('aria-expanded', String(!isCollapsed));
        if (toggleText) toggleText.textContent = isCollapsed ? 'SHOW' : 'HIDE';
        if (toggleIcon) toggleIcon.textContent = isCollapsed ? '▼' : '▲';
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGsocIndexToggle);
  } else {
    setupGsocIndexToggle();
  }
</script>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 24px;
  }
  .gsoc-section-label {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--blue-bright);
    margin-top: 24px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.05em;
  }
  .gsoc-section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border-bright) 0%, transparent 100%);
  }
  .gsoc-index-panel {
    background: var(--bg-panel);
    border: 1px solid var(--border-bright);
    border-radius: 12px;
    padding: 18px 20px;
    margin-bottom: 24px;
    font-family: var(--font-mono);
    transition: all 0.2s ease;
  }
  .gsoc-index-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 10px;
    margin-bottom: 14px;
    border-bottom: 1px dashed var(--border);
  }
  .gsoc-index-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text);
  }
  .gsoc-prompt {
    color: var(--blue-bright);
    margin-right: 6px;
  }
  .gsoc-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .gsoc-index-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--blue-bright);
    background: rgba(47, 129, 247, 0.1);
    border: 1px solid rgba(47, 129, 247, 0.3);
    padding: 2px 8px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }
  .gsoc-index-toggle {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-dim);
    background: var(--bg-panel-2);
    border: 1px solid var(--border);
    padding: 3px 9px;
    border-radius: var(--radius-xs);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all 0.15s ease;
  }
  .gsoc-index-toggle:hover {
    color: var(--blue-bright);
    border-color: var(--border-bright);
    background: rgba(47, 129, 247, 0.08);
  }
  .gsoc-index-panel.is-collapsed .gsoc-index-content {
    display: none;
  }
  .gsoc-index-panel.is-collapsed .gsoc-index-header {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .gsoc-module-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--blue-bright);
    margin-bottom: 10px;
  }
  .gsoc-index-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 8px 16px;
  }
  .gsoc-index-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    color: var(--text-dim);
    text-decoration: none;
    padding: 6px 10px;
    background: var(--bg-panel-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: all 0.15s ease;
  }
  .gsoc-index-item:hover {
    color: var(--blue-bright);
    border-color: var(--border-bright);
    transform: translateX(2px);
  }
  .gsoc-item-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gsoc-item-arrow {
    color: var(--blue-bright);
    margin-left: 8px;
  }
</style>
